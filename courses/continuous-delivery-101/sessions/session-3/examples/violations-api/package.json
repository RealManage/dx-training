{
  "name": "aws-violations-api",
  "version": "0.1.0",
  "private": true,
  "description": "HOA Violations API — CD 101 teaching example (TypeScript Lambda + SAM)",
  "type": "module",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/handler.js",
    "validate": "sam validate --lint"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  }
}
