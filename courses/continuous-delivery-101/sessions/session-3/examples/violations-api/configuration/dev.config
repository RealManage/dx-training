# Per-environment deploy config for aws-violations-api. Sourced by the .deploy job
# in ../.gitlab-ci.yml, then passed to `sam deploy` via --parameter-overrides.
#
# This is where "config travels with the artifact" (CD minimum #9) lives: the SAME
# built artifact deploys to every environment; only these values differ. Feature
# flags default OFF in template.yaml so code ships DARK — turning one true here is
# the RELEASE for that environment (a config change through the pipeline that
# redeploys the same bytes, never new code). That is deploy != release, made concrete.

# dev: the team's own environment — feature on so developers exercise it.
FLAG_VIOLATIONS_RECORD=true
FLAG_VIOLATIONS_NOTIFY=true
