# See dev.config for what this file is and how it's used.
#
# prod: the artifact is DEPLOYED here but the feature is DARK — flags off. Flipping
# one of these to true and re-running the pipeline is the RELEASE decision: the same
# bytes that passed qa, now switched on for users. No rebuild, no new artifact.
FLAG_VIOLATIONS_RECORD=false
FLAG_VIOLATIONS_NOTIFY=false
